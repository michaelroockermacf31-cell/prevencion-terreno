<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Prevención en Terreno (Demo)</title>
<style>
:root{--bg:#0f172a;--card:#1e293b;--in:#0f172a;--tx:#e2e8f0;--mu:#94a3b8;--bd:#334155;--bl:#3b82f6;--rd:#ef4444;--gr:#10b981;--ye:#f59e0b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f1f5f9;--card:#fff;--in:#f8fafc;--tx:#0f172a;--mu:#475569;--bd:#cbd5e1}}
:root[data-theme="dark"]{--bg:#0f172a}
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,sans-serif}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{background:var(--bg);color:var(--tx);padding-bottom:30px}
header{background:var(--card);padding:14px;text-align:center;font-weight:700;border-bottom:2px solid var(--bl)}
.tabs{display:flex;overflow-x:auto;background:var(--card)}
.tab{flex:1 0 auto;padding:12px 14px;background:none;border:0;border-bottom:3px solid transparent;color:var(--mu);font-weight:700;font-size:.85rem}
.tab.on{color:var(--bl);border-bottom-color:var(--bl)}
.pg{display:none;padding:14px}.pg.on{display:block}
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:14px;margin-bottom:14px}
h2{font-size:1.1rem;margin-bottom:8px}h3{font-size:.95rem;color:var(--bl);margin:12px 0 4px}
p,li{font-size:.9rem;line-height:1.5;color:var(--mu)}ul{padding-left:18px}
label{display:block;margin-top:10px;font-size:.85rem;font-weight:700;color:var(--mu)}
input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid var(--bd);background:var(--in);color:var(--tx);margin:5px 0;font-size:1rem}
.btn{width:100%;padding:12px;border:0;border-radius:8px;font-weight:700;font-size:1rem;background:var(--bl);color:#fff;margin-top:10px}
.btn.g{background:var(--gr)}.btn.y{background:var(--ye);color:#000}.btn.s{background:#64748b}
.row{display:flex;gap:10px}.row>*{flex:1}
.box{background:var(--in);border-left:4px solid var(--gr);border-radius:8px;padding:12px;margin-top:10px;white-space:pre-wrap;font-size:.95rem;line-height:1.5;color:var(--tx)}
.chk{display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--bd);font-size:.92rem;color:var(--tx)}
.chk input{width:20px;height:20px;margin:0}
canvas{width:100%;height:150px;background:#fff;border-radius:8px;touch-action:none;display:block}
.timer{font-size:2.4rem;font-weight:800;text-align:center;margin:8px 0}
.al{padding:10px;border-radius:8px;margin-top:10px;font-size:.9rem}
.al.r{background:#ef444433;color:var(--tx);border:1px solid var(--rd)}.al.v{background:#10b98133;color:var(--tx);border:1px solid var(--gr)}.al.a{background:#f59e0b33;color:var(--tx);border:1px solid var(--ye)}
.fl{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--bd);padding:6px 0;font-size:.88rem;color:var(--tx)}
.fl img{height:34px;background:#fff;border-radius:4px}
#imp{display:none}
@media print{body>*:not(#imp){display:none!important}#imp{display:block;background:#fff;padding:8mm;font-size:12px}#imp *{color:#000!important}#imp img{height:46px}#imp table{width:100%;border-collapse:collapse;margin-bottom:10px}#imp td,#imp th{border:1px solid #000;padding:4px;text-align:left}#imp pre{white-space:pre-wrap;font-family:inherit;margin:8px 0}}
</style>
<link rel="manifest" href="manifest-demo.json">
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Prevención">
<link rel="icon" type="image/png" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
</head>
<body>
<header>Prevención en Terreno</header>
<div id="tr" style="display:none;background:#f59e0b;color:#000;text-align:center;padding:6px;font-size:.85rem;font-weight:700"></div>
<div class="tabs">
<button class="tab on" data-p="charla">Charla 5 min</button>
<button class="tab" data-p="ind">Inducción</button>
<button class="tab" data-p="reg">Registro</button>
</div>

<!-- CHARLA -->
<div id="charla" class="pg on">
<div class="card">
<h2>Charla de seguridad matutina</h2>
<p>Para jefe de terreno, supervisor o capataz. Dura 5 minutos: el cronómetro ayuda a no alargarla.</p>
<label>Quien dicta la charla</label><input id="c-exp" placeholder="Nombre y cargo">
<label>Tema</label>
<div class="row"><select id="c-sel"></select><button class="btn" style="flex:0 0 56px;margin:5px 0" onclick="dictarCharla()">🎤</button></div>
<p>Tip: toca el micrófono y di el tema, por ejemplo «salud mental».</p>
<button class="btn y" onclick="charla(true)">Tema aleatorio</button>
<button class="btn" onclick="charla(false)">Generar charla</button>
<div id="c-out" class="box" style="display:none"></div>
<div class="timer" id="c-t">05:00</div>
<div class="row"><button class="btn g" onclick="cron()">Iniciar / pausar</button><button class="btn s" onclick="cronReset()">Reiniciar</button></div>
<label>Asistentes (uno por línea)</label><textarea id="c-as" rows="4" placeholder="Nombre o RUT"></textarea>
<button class="btn y" onclick="pdfCharla()">Generar PDF de la charla</button>
<button class="btn g" onclick="guardarCharla()">Guardar registro de charla</button>
<button class="btn s" onclick="copiar('c-out')">Copiar charla</button>
<h3>Charlas registradas</h3><div id="c-h" class="box" style="border-color:var(--bd)"></div>
</div></div>

<!-- INDUCCION -->
<div id="ind" class="pg">
<div class="card">
<h2>Inducción previa al trabajo</h2>
<p>Dicta o escribe el trabajo (ej: «trabajo en altura», «espacio confinado»).</p>
<div class="row"><input id="i-t" placeholder="Tipo de trabajo"><button class="btn" style="flex:0 0 56px;margin:5px 0" onclick="dictar()">🎤</button></div>
<label>Tipo de trabajo (lista)</label><select id="i-s" onchange="if(this.value){$('i-t').value=this.value;induccion()}"><option value="">Elegir de la lista...</option></select>
<label>Lugar / frente de trabajo</label><input id="i-lug" placeholder="Ej: Torre B, piso 5">
<div class="row"><div><label>Dónde se hace</label><select id="i-sit"><option>Terreno</option><option>Casino</option><option>Comedor</option><option>Sala</option><option>Otro</option></select></div><div><label>Duración (min)</label><input id="i-dur" type="number" inputmode="numeric" value="60"></div></div>
<button class="btn" onclick="induccion()">Crear inducción completa</button>
<label>Inducción (editable)</label>
<textarea id="i-txt" rows="12" placeholder="Aquí aparece la inducción completa."></textarea>
<label>Checklist en terreno</label>
<div id="i-chk" class="box" style="border-color:var(--bl)">Crea la inducción para ver el checklist.</div>
</div>
<div class="card">
<h2>Firmas</h2>
<p>Solo dos roles: prevencionista (1 firma) y trabajadores (una por persona). Tras autorizar, la firma se borra para el siguiente.</p>
<label>Firma como</label>
<select id="f-rol"><option value="Trabajador">Trabajador</option><option value="Prevencionista">Prevencionista</option></select>
<label>RUT</label><input id="f-rut" inputmode="text" placeholder="12.345.678-9" autocomplete="off">
<label>Nombre (opcional)</label><input id="f-nom" placeholder="Nombre">
<label>Curso o autorización para este trabajo</label><input id="f-cur" placeholder="Ej: Curso trabajo en altura, vigente hasta 12/2026">
<label class="chk"><input type="checkbox" id="f-ok"><span>Tiene el curso vigente y está autorizado para este trabajo (obligatorio para trabajadores)</span></label>
<canvas id="cv"></canvas>
<div class="row"><button class="btn s" onclick="limpiar()">Borrar firma</button><button class="btn g" onclick="autorizar()">Autorizar firma</button></div>
<div id="f-msg"></div>
<h3>Firmas registradas (<span id="f-n">0</span>)</h3>
<div id="f-list" class="box" style="border-color:var(--bd)">Nadie ha firmado aún.</div>
<button class="btn y" onclick="pdf()">Generar PDF de inducción</button>
<button class="btn g" onclick="guardarInd()">Guardar en registro</button>
<button class="btn s" onclick="enviar('w')">Enviar por WhatsApp</button>
<button class="btn s" onclick="enviar('c')">Enviar por correo</button>
<button class="btn s" onclick="resumen()">Copiar resumen</button>
<button class="btn s" onclick="respaldo()">Descargar respaldo (.json)</button>
<button class="btn s" onclick="nueva()">Nueva inducción (borra firmas)</button>
<p style="margin-top:8px">En el diálogo de impresión elige «Guardar como PDF». Las firmas quedan guardadas en este dispositivo.</p>
</div></div>

<!-- REGISTRO -->
<div id="reg" class="pg">
<div class="card"><h2>Inducciones de hoy</h2><p>Para supervisor y capataz: revisa si el trabajo ya tiene inducción antes de partir.</p><div id="r-hoy" class="box" style="border-color:var(--bl)"></div></div>
<div class="card"><h2>Historial</h2><input id="r-q" placeholder="Buscar por trabajo o fecha" oninput="regLista()"><div id="r-l" class="box" style="border-color:var(--bd)"></div></div>
</div>
<div id="lock" style="position:fixed;inset:0;background:var(--bg);z-index:99;display:none;align-items:center;justify-content:center;padding:20px"></div>
<div id="imp"></div>
<script>
const $=id=>document.getElementById(id);
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
 document.querySelectorAll('.tab,.pg').forEach(e=>e.classList.remove('on'));
 b.classList.add('on');$(b.dataset.p).classList.add('on');
 if(b.dataset.p==='ind')ajustar();if(b.dataset.p==='reg'&&window.regLista)regLista();
});
function copiar(id){const t=$(id).value||$(id).innerText;try{navigator.clipboard.writeText(t).then(()=>alert('Copiado'),()=>alert('No se pudo copiar'))}catch(e){alert('No se pudo copiar')}}

/* CHARLA */
const T=[
["Protección de manos","Muchos accidentes de obra ocurren en las manos.","Usar guantes adecuados a la tarea; no usar herramientas dañadas; guardar el cuchillo cortacartón con la hoja replegada.","¿Qué guante corresponde a tu tarea de hoy?"],
["Trabajo en altura","Una caída desde baja altura también puede causar lesiones graves.","Arnés revisado, doble cabo, anclaje certificado y zona inferior delimitada. Nunca soltarse del anclaje.","¿Dónde está tu punto de anclaje hoy?"],
["Orden y aseo","Cables, escombros y clavos en el piso causan tropiezos y cortes.","Limpiar tu zona antes de irte, apilar materiales y retirar clavos de la madera.","¿Qué puedes ordenar ahora en tu frente?"],
["Fatiga y descanso","El cansancio baja los reflejos y la atención.","Avisa al supervisor si dormiste mal, toma pausas e hidrátate.","¿Alguien hoy no se siente en condiciones?"],
["Excavaciones y zanjas","Un derrumbe puede ocurrir sin aviso.","No acopiar material al borde, revisar taludes o entibado y mantener escalera de salida.","¿Cuál es tu salida si cede el talud?"],
["Izaje de cargas","Una carga suspendida puede caer o balancearse.","Nadie bajo la carga, eslingas revisadas, una sola persona da las señales.","¿Quién da las señales hoy?"],
["Uso de EPP","El EPP es la última barrera: solo funciona si está en buen estado y bien puesto.","Casco con barbiquejo si corresponde, lentes limpios, calzado de seguridad, protección auditiva en ruido.","Revisa tu EPP: ¿alguno está dañado?"],
["Riesgo eléctrico","Los tableros y alargadores en mal estado causan descargas.","No intervenir instalaciones si no estás autorizado; alargadores sin empalmes y fuera del agua.","¿Hay algún cable pelado en tu zona?"],
["Salud mental y estrés","El estrés, la ansiedad y la tristeza afectan la atención y aumentan el riesgo de accidentes.","Reconocer señales (irritabilidad, insomnio, desgano, aislamiento), conversar con alguien de confianza y pedir apoyo al supervisor o a la mutualidad. Pedir ayuda es de valientes.","¿Cómo podemos cuidarnos como equipo esta semana?","salud mental estres ansiedad depresion animo emocional"],
["Alcohol, drogas y medicamentos","Trabajar bajo los efectos de alcohol, drogas o ciertos medicamentos pone en riesgo a todos.","No ingresar con síntomas. Si tomas un remedio que da sueño o mareo, avisa al supervisor. Conocer la política de alcohol y drogas de la empresa.","¿Conoces la política de la empresa?","alcohol drogas medicamentos remedios"],
["Calor y radiación solar","El calor extremo y el sol causan golpe de calor, deshidratación y quemaduras.","Tomar agua cada 20 minutos, pausas a la sombra, protector solar, ropa liviana de manga larga. Mareo, calambres o piel seca y caliente son señales de alerta.","¿Dónde están el agua y la sombra de hoy?","calor sol uv hidratacion verano insolacion"],
["Frío, lluvia y viento","El frío y la lluvia aumentan resbalones, hipotermia y fallas de equipos.","Ropa en capas e impermeable, calzado antideslizante, suspender trabajos en altura con viento o lluvia fuerte.","¿Qué trabajos de hoy se ven afectados por el clima?","frio lluvia invierno viento hipotermia clima"],
["Primeros auxilios","Los primeros minutos después de un accidente son decisivos.","Saber dónde está el botiquín y quiénes están capacitados. Llamar a emergencias. No mover a un accidentado con posible lesión de columna.","¿Dónde está el botiquín y quién llama a emergencias?","primeros auxilios botiquin emergencia accidente herido"],
["Plan de emergencia y evacuación","En una emergencia no hay tiempo para pensar.","Conocer las vías de evacuación, la zona de seguridad y la señal de alarma. Mantener las vías despejadas. Ante un sismo: mantener la calma, alejarse de bordes y evacuar cuando pase.","¿Cuál es nuestra zona de seguridad?","emergencia evacuacion sismo terremoto zona de seguridad alarma"],
["Incendios y extintores","Un incendio en obra se propaga rápido por materiales combustibles.","Ubicar los extintores y no bloquearlos. No fumar cerca de combustibles. Para usar un extintor: tirar el seguro, apuntar a la base del fuego, apretar y barrer.","¿Dónde está el extintor más cercano?","incendio extintor fuego combustible"],
["Manejo manual de cargas","Las lesiones de espalda son de las más frecuentes en obra.","Doblar rodillas, espalda recta, carga pegada al cuerpo. Pedir ayuda o usar carretilla si pesa mucho (el máximo legal es 25 kg; verifica la norma).","¿Qué carga de hoy pide ayuda mecánica?","carga espalda lumbar levantar manual ergonomia peso"],
["Posturas y pausas activas","Las malas posturas y los movimientos repetidos causan dolores y lesiones.","Cambiar de postura, estirar cada cierto tiempo, no trabajar mucho rato agachado ni con los brazos sobre la cabeza.","Hagamos 1 minuto de estiramiento juntos.","postura pausa activa estiramiento ergonomia dolor"],
["Ruido y protección auditiva","La pérdida de audición por ruido es permanente.","Usar protección auditiva en zonas ruidosas y verificar que esté bien puesta. Si tienes que gritar para hablar, hay riesgo.","¿Qué equipos de hoy hacen más ruido?","ruido sordera auditiva oido"],
["Polvo y sílice","Respirar polvo de sílice puede causar una enfermedad pulmonar grave.","Cortar y esmerilar con agua o extracción, usar mascarilla adecuada al riesgo, no barrer en seco.","¿Qué tarea de hoy genera polvo?","polvo silice respirador mascarilla silicosis"],
["Herramientas manuales y eléctricas","Una herramienta dañada o mal usada causa cortes y golpes.","Revisar antes de usar, usar protecciones y cables en buen estado, desconectar al cambiar discos.","¿Alguna herramienta está dañada?","herramienta herramientas esmeril taladro cortes"],
["Escaleras portátiles","Muchas caídas ocurren desde escaleras.","Apoyo estable, tres puntos de contacto, ángulo correcto, sobrepasar 1 m el punto de llegada, no usar los dos últimos peldaños ni escalera metálica cerca de electricidad.","¿Tu escalera está en buen estado?","escalera escala portatil"],
["Andamios","Un andamio mal armado o mal usado es una caída segura.","Usar solo andamios con tarjeta vigente, con barandas, rodapiés y plataformas completas; no sobrecargar ni modificar.","¿El andamio de hoy tiene tarjeta vigente?","andamio andamios"],
["Aberturas, bordes y barandas","Los bordes de losa y las aberturas sin protección causan caídas graves.","No retirar barandas ni tapas, señalizar y reponer de inmediato si falta una protección.","¿Hay alguna abertura sin protección?","abertura borde baranda losa hoyo"],
["Maquinaria y peatones","Los atropellos por maquinaria son accidentes muy graves.","Mantener distancia, nunca ubicarse en puntos ciegos, respetar señaleros y vías peatonales.","¿Por dónde circula la maquinaria hoy?","maquinaria camion vehiculos transito atropello"],
["Señalización y zonas delimitadas","Las señales y barreras existen porque hay un riesgo detrás.","Respetar cintas, conos y letreros. No cruzar zonas delimitadas sin autorización.","¿Qué zonas están delimitadas hoy?","senal senalizacion delimitar cinta conos"],
["Reporte de incidentes y casi accidentes","Cada casi accidente es un aviso de lo que puede ocurrir.","Reportar de inmediato lo que pasó, sin buscar culpables. Reportar ayuda a corregir antes de que alguien se lesione.","¿Alguien vio algo peligroso esta semana?","incidente reporte casi accidente cuasi"],
["Accidentes y seguro (Ley 16.744)","Todo accidente laboral debe reportarse a tiempo para tener cobertura.","Avisar de inmediato al supervisor, ir a la mutualidad y nunca ocultar un accidente ni una lesión.","¿Sabes a qué centro de atención ir?","ley 16744 accidente mutualidad seguro derechos"],
["Buen trato y respeto (Ley Karin)","Todos merecen un trato digno; el acoso y la violencia laboral no se toleran.","Tratar con respeto, evitar bromas ofensivas y saber que existe un canal confidencial para denunciar.","¿Conocemos el canal de denuncia de la empresa?","ley karin acoso buen trato respeto violencia discriminacion"],
["Atrapamientos y partes móviles","Las partes móviles de las máquinas atrapan manos, ropa y pelo.","No quitar protecciones, apagar y bloquear antes de limpiar o reparar, evitar ropa suelta y cadenas.","¿Qué máquina de hoy tiene partes móviles?","atrapamiento maquina partes moviles bloqueo"],
["Traslados y conducción","Muchos accidentes ocurren yendo o volviendo del trabajo.","Usar cinturón, no usar el celular al conducir, respetar velocidad y descansar antes de manejar.","¿Cómo vienes y cómo te vas hoy?","conduccion transito trayecto vehiculo cinturon"],
["Protección de ojos y rostro","Las proyecciones y el polvo pueden causar daño ocular permanente.","Usar lentes o careta según la tarea, mantenerlos limpios y cambiarlos si están rayados.","¿Qué lentes corresponden a tu tarea?","ojos lentes proyeccion careta vista"],
["Comunicación y trabajo en equipo","Una mala comunicación es causa común de accidentes.","Confirmar las instrucciones, usar señales claras, avisar los cambios del trabajo a todo el equipo.","¿Todos entendieron el trabajo de hoy?","comunicacion equipo instrucciones señales"],
["Derecho a detener el trabajo","Nadie debe trabajar en condiciones inseguras.","Si algo no es seguro, se detiene el trabajo, se avisa al supervisor y se retoma cuando esté corregido. No habrá represalias.","¿Qué haría cada uno si ve un riesgo?","detener trabajo autocuidado derecho parar"]];
$('c-sel').innerHTML=T.map((t,i)=>`<option value="${i}">${t[0]}</option>`).join('');
function charla(r){if(r)$('c-sel').value=Math.floor(Math.random()*T.length);
 const t=T[$('c-sel').value],e=$('c-exp').value.trim()||'—';const o=$('c-out');o.style.display='block';
 o.textContent=`TEMA: ${t[0]}\nExpositor: ${e}\n\n1) Por qué importa (1 min)\n${t[1]}\n\n2) Qué hacer (2 min)\n${t[2]}\n\n3) Pregunta al equipo (1 min)\n${t[3]}\n\n4) Cierre (1 min)\nCada uno repite en voz alta su riesgo principal de hoy. Pasar lista y empezar.`;cronReset()}
let ct=300,ci=null;
function pinta(){$('c-t').textContent=String(Math.floor(ct/60)).padStart(2,'0')+':'+String(ct%60).padStart(2,'0');$('c-t').style.color=ct===0?'var(--rd)':''}
function cron(){if(ci){clearInterval(ci);ci=null;return}ci=setInterval(()=>{if(ct>0){ct--;pinta()}else{clearInterval(ci);ci=null}},1000)}
function cronReset(){clearInterval(ci);ci=null;ct=300;pinta()}

/* INDUCCION */
function dictar(){const R=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!R){alert('Tu navegador no permite dictado. Escribe el trabajo.');return}
 try{const r=new R();r.lang='es-CL';r.onresult=e=>{$('i-t').value=e.results[0][0].transcript;induccion()};r.onerror=()=>alert('No se pudo escuchar.');r.start()}catch(e){alert('Dictado no disponible.')}}
const COM="Antes de partir: charla de 5 min, EPP completo y en buen estado, herramientas revisadas, conocer vías de evacuación, ubicación de botiquín y extintor, y a quién avisar en una emergencia. Si algo cambia o hay duda: DETENER el trabajo y avisar al supervisor.";
const IND=[
