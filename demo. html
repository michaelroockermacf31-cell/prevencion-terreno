 if(!rut){msg('RUT inválido. Revisa el número y el dígito verificador.','r');return}
 if(rol==='Trabajador'&&window.LIC&&LIC.m>0&&F.filter(f=>f.rol==='Trabajador').length>=LIC.m&&!F.some(f=>f.rol==='Trabajador'&&f.rut===rut)){msg('Tu licencia permite hasta '+LIC.m+' trabajadores por inducción.','r');return}
 if(!tiene){msg('Falta la firma en el recuadro.','r');return}
 if(rol==='Trabajador'&&F.some(f=>f.rol==='Trabajador'&&f.rut===rut)){msg('Ese RUT ya firmó.','r');return}
 if(rol==='Trabajador'&&(!$('f-ok').checked||!$('f-cur').value.trim())){msg('Solo firman quienes tienen el curso vigente: indica el curso y confirma.','r');return}
 if(rol==='Prevencionista')F=F.filter(f=>f.rol!=='Prevencionista');
 F.push({rol,rut,nom:$('f-nom').value.trim(),cur:rol==='Trabajador'?$('f-cur').value.trim():'',img:cv.toDataURL(),h:new Date().toLocaleString('es-CL')});
 limpiar();$('f-rut').value='';$('f-nom').value='';$('f-ok').checked=false;sv('F',F);msg('Firma registrada. Puede firmar el siguiente.','v');lista()}
