const cv=$('cv'),cx=cv.getContext('2d');let dib=false,tiene=false;
function ajustar(){const w=cv.offsetWidth,h=cv.offsetHeight;if(w&&(cv.width!==w||cv.height!==h)){cv.width=w;cv.height=h;tiene=false}}
function pos(e){const r=cv.getBoundingClientRect();return[e.clientX-r.left,e.clientY-r.top]}
cv.addEventListener('pointerdown',e=>{ajustar();dib=true;cv.setPointerCapture(e.pointerId);const[x,y]=pos(e);cx.beginPath();cx.moveTo(x,y);cx.lineWidth=2.5;cx.lineCap='round';cx.strokeStyle='#000'});
cv.addEventListener('pointermove',e=>{if(!dib)return;const[x,y]=pos(e);cx.lineTo(x,y);cx.stroke();tiene=true});
['pointerup','pointercancel'].forEach(v=>cv.addEventListener(v,()=>dib=false));
function limpiar(){cx.clearRect(0,0,cv.width,cv.height);tiene=false}
function rutOk(r){r=r.replace(/[^0-9kK]/g,'').toUpperCase();if(r.length<8||r.length>9)return null;const d=r.slice(-1),n=r.slice(0,-1);let s=0,m=2;for(let i=n.length-1;i>=0;i--){s+=+n[i]*m;m=m===7?2:m+1}const v=11-s%11,e=v===11?'0':v===10?'K':String(v);return e===d?n.replace(/\B(?=(\d{3})+(?!\d))/g,'.')+'-'+d:null}
